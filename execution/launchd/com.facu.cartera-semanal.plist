<?xml version="1.0" encoding="UTF-8"?>
<!--
  Guardián de la cartera personal de Facu. Lunes 9:30, por Telegram.

  Instalar:
    cp ~/facu-os/execution/launchd/com.facu.cartera-semanal.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.facu.cartera-semanal.plist
    launchctl list | grep facu

  Probar sin esperar al lunes:
    launchctl start com.facu.cartera-semanal
    tail -20 ~/facu-os/data/logs/cartera-semanal.log

-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.facu.cartera-semanal</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/Facu/facu-os/execution/launchd/correr.sh</string>
        <string>cartera-semanal</string>
        <string>--</string>
        <string>/Users/Facu/facu-os/.venv/bin/python /Users/Facu/facu-os/execution/cartera_semanal.py --send</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/Facu/facu-os</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- Si la Mac estaba apagada a la hora programada, corre al prender. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/Facu/facu-os/data/logs/cartera-semanal.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Facu/facu-os/data/logs/cartera-semanal.log</string>
</dict>
</plist>
