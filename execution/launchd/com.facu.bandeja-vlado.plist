<?xml version="1.0" encoding="UTF-8"?>
<!--
  Bandeja de Vlado: cada 15 min, si Vlado dejó tareas en astronomy-os bandeja/para/Facu, un Claude
  headless las hace solo y avisa por Telegram (pedido de Facu 27/11/2026). Script: execution/bandeja_vlado.sh

  Instalar:
    cp ~/facu-os/execution/launchd/com.facu.bandeja-vlado.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.facu.bandeja-vlado.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.facu.bandeja-vlado</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/Facu/facu-os/execution/launchd/correr.sh</string>
        <string>bandeja-vlado</string>
        <string>--</string>
        <string>/bin/bash /Users/Facu/facu-os/execution/bandeja_vlado.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/Facu/facu-os</string>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/Facu/facu-os/data/logs/bandeja-vlado.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Facu/facu-os/data/logs/bandeja-vlado.log</string>
</dict>
</plist>
