# Copiar a .env y completar. El .env NUNCA se commitea ni se pega en el chat.
# Si una key se pegó en un chat, ya está quemada: rotala.

# Claude API (solo si algún script llama a la API por su cuenta)
ANTHROPIC_API_KEY=

# Google (Sheets/Drive). OJO: la key de Cloud Console cobra a Cloud.
# Para créditos gratis usar aistudio.google.com/apikey.
# Si la app OAuth queda en "Testing", el token vence cada 7 días → publicar a Producción.
GOOGLE_API_KEY=

# WhatsApp / mensajería (cuando exista el skill de avisos a los locatarios)
WHATSAPP_TOKEN=
