# Copiar a .env y completar. El .env NUNCA se commitea ni se pega en el chat.
# Si una key se pegó en un chat, ya está quemada: rotala.

# --- Gemini (volumen barato, leer fotos y capturas, segunda opinión) ---
# Sacala de https://aistudio.google.com/apikey
# OJO: la key de Google Cloud Console cobra a Cloud. Solo la de AI Studio usa
# los créditos gratis.
GEMINI_API_KEY=
# Correr `.venv/bin/python execution/gemini.py --modelos` y elegir uno.
# Flash para volumen, Pro para razonar. No hay default: un ID inventado falla
# en silencio al primer uso.
GEMINI_MODEL=

# --- Claude API (solo si un script llama a la API por su cuenta) ---
ANTHROPIC_API_KEY=

# --- Google Sheets / Gmail ---
# No van keys acá: el acceso es por OAuth. Poner `credentials.json` en la raíz
# (Cloud Console → Credenciales → ID de cliente OAuth → App de escritorio) y
# correr una vez:  .venv/bin/python execution/google_auth.py --setup
# La consent screen tiene que estar en PRODUCCIÓN, no en Testing: en Testing el
# token vence cada 7 días.

# --- Vercel (deploys de astronomy-members) ---
# Token de https://vercel.com/account/tokens  (Scope: Full Account, sin vencimiento)
VERCEL_TOKEN=

# --- Supabase (base de astronomy-members y de la app del Paseo) ---
# Token de https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# --- Apify (scraping de Google Maps para prospectar) ---
# apify.com → Settings → API & Integrations. Tiene free tier mensual; pasado
# eso cobra ~USD 0,015 por listado (~USD 1,50 cada 100). Sin esta key, el skill
# `prospectar-gmaps` no corre.
APIFY_API_TOKEN=

# --- Destinatarios de reportes ---
MAIL_FACU=facue1900@gmail.com
MAIL_RICHI=re1900@gmail.com
